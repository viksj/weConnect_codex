PORT=4000
NODE_ENV=development
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EXPO_ORIGINS=exp://
JSON_BODY_LIMIT=10mb
LOCAL_UPLOAD_MAX_BYTES=8388608

# Encryption key for message encryption
ENCRYPTION_KEY=weconnect-translation-chat-secret-key-2024

# memory | mysql | mongodb
DB_PROVIDER=mysql
DB_INIT_SCHEMA=true
DB_SEED_DEMO_USERS=false

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=weconnect
MYSQL_CONNECTION_LIMIT=10

# MongoDB, used when DB_PROVIDER=mongodb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=translation_chat

# Keep disabled outside local prototype/debug sessions.
# When true, web can sign in locally with OTP 123456 if Firebase config is missing.
ENABLE_DEMO_OTP=false
ENABLE_DEBUG_MESSAGES=false

# Optional production translation provider: openai | libretranslate
# TRANSLATION_PROVIDER=openai
# OPENAI_API_KEY=sk-your_key
# OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
#
# TRANSLATION_PROVIDER=libretranslate
# LIBRE_TRANSLATE_URL=https://libretranslate.example.com
# LIBRE_TRANSLATE_API_KEY=optional_api_key
